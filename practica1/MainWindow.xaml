<Window x:Class="practica1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:practica1"
        mc:Ignorable="d"
        Title="Polestar Spain"
        Height="650"
        Width="1000"
        PreviewKeyDown="Ventana_PreviewKeyDown">

    <Grid x:Name="LayoutRoot">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera común -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1">

            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BotonMenu"
                        Grid.Column="0"
                        Content="☰ Menú"
                        Width="95"
                        Height="36"
                        VerticalAlignment="Center"
                        Click="BotonMenu_Click"/>

                <Image Grid.Column="2"
                       Source="Imagenes/logo.png"
                       Width="180"
                       Height="40"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Polestar"/>
            </Grid>
        </Border>

        <!-- Zona donde se cargan las vistas -->
        <Grid x:Name="ZonaContenido"
              Grid.Row="1"
              Margin="30">

            <ContentControl x:Name="ContenidoPrincipal"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>

        <!-- Menú superpuesto -->
        <Grid x:Name="CapaMenu"
              Grid.Row="1"
              Panel.ZIndex="10"
              Visibility="Collapsed">

            <!-- Área transparente que captura el clic fuera del menú -->
            <Button Background="Transparent"
                    BorderThickness="0"
                    Focusable="False"
                    IsTabStop="False"
                    Click="CerrarMenu_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Width="230"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="White"
                    BorderBrush="#D0D0D0"
                    BorderThickness="0,0,1,0">

                <StackPanel Margin="15">
                    <TextBlock Text="Secciones"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>

                    <Button Content="Inicio"
                            Height="40"
                            Margin="0,0,0,10"
                            Click="IrInicio_Click"/>

                    <Button Content="Identificación"
                            Height="40"
                            Margin="0,0,0,10"
                            Click="IrIdentificacion_Click"/>

                    <Button Content="Galería"
                            Height="40"
                            Click="IrGaleria_Click"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>