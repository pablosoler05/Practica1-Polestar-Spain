<UserControl x:Class="practica1.VistaInicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid>

            <!-- Aparición suave al cargar la vista -->
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="Opacity"
                                From="0"
                                To="1"
                                Duration="0:0:0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título de la sección -->
            <TextBlock Grid.Row="0"
                       Text="Inicio"
                       FontSize="24"
                       Foreground="#222222"
                       Margin="0,0,0,20"/>

            <!-- Novedades y ofertas -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Novedades -->
                <StackPanel Grid.Column="0">

                    <Border Height="220" Background="Transparent">
                        <Image Source="Imagenes/polestar4.png"
                               Stretch="Uniform"
                               AutomationProperties.Name="Polestar 4 destacado"/>
                    </Border>

                    <TextBlock Text="Descubre el Polestar 4"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#222222"
                               Margin="0,15,0,8"/>

                    <TextBlock Text="Diseño de SUV coupé, espacio y movilidad eléctrica. Conoce el Polestar 4 y encuentra tu próximo vehículo en nuestra galería."
                               FontSize="16"
                               Foreground="#222222"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Ofertas y campañas -->
                <StackPanel Grid.Column="2">

                    <Border Height="220" Background="Transparent">
                        <Image Source="Imagenes/polestar2.png"
                               Stretch="Uniform"
                               AutomationProperties.Name="Polestar 2 en oferta"/>
                    </Border>

                    <TextBlock Text="Ofertas de temporada · Polestar 2"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#222222"
                               Margin="0,15,0,8"/>

                    <TextBlock Text="Polestar 2 desde 41.900 €. Descubre este fastback eléctrico de diseño escandinavo. Precio sujeto a versión, disponibilidad y condiciones de la oferta."
                               FontSize="16"
                               Foreground="#222222"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Acceso al catálogo completo -->
            <Button Grid.Row="2"
                    Content="Ver galería"
                    FontSize="16"
                    Padding="20,10"
                    Margin="0,25,0,0"
                    HorizontalAlignment="Left"
                    Click="VerGaleria_Click"/>
        </Grid>
    </ScrollViewer>
</UserControl>