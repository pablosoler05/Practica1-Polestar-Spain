<UserControl x:Class="practica1.VistaIdentificacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="1"
                                 Duration="0:0:0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Identificación"
                       FontSize="24"
                       Foreground="#222222"
                       Margin="0,0,0,20"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Fotografía de Polestar -->
                <Border Grid.Column="0"
                        MinHeight="300"
                        ClipToBounds="True">

                    <Border.Background>
                        <ImageBrush ImageSource="Imagenes/identificacion.png"
                                    Stretch="UniformToFill"
                                    AlignmentX="Right"
                                    AlignmentY="Center"/>
                    </Border.Background>
                </Border>

                <!-- Formulario -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">

                    <TextBlock Text="Acceso de clientes"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#222222"
                               Margin="0,0,0,20"/>

                    <Label Content="_Usuario"
                           Target="{Binding ElementName=txtUsuario}"
                           FontSize="16"
                           Foreground="#222222"
                           Padding="0"
                           Margin="0,0,0,6"/>

                    <TextBox x:Name="txtUsuario"
                             FontSize="16"
                             Padding="8"
                             Margin="0,0,0,15"/>

                    <Label Content="_Contraseña"
                           Target="{Binding ElementName=txtPassword}"
                           FontSize="16"
                           Foreground="#222222"
                           Padding="0"
                           Margin="0,0,0,6"/>

                    <PasswordBox x:Name="txtPassword"
                                 FontSize="16"
                                 Padding="8"
                                 Margin="0,0,0,20"/>

                    <Button Content="Iniciar sesión"
                            FontSize="16"
                            Padding="15,10"
                            HorizontalAlignment="Left"
                            Click="IniciarSesion_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>